---
interface Props { page: string; labels: { web3: string; web2: string; projects: string; world: string }; label: string }
const { page, labels, label } = Astro.props;
const home = page === 'home';
---
<nav class="tabs" aria-label={label}>
  <a href={home ? '#web3' : '/#web3'} data-tab="web3" data-action={home ? 'section:web3' : undefined}>{labels.web3}</a>
  <a href={home ? '#web2' : '/#web2'} data-tab="web2" data-action={home ? 'section:web2' : undefined}>{labels.web2}</a>
  <a href={home ? '#projects' : '/#projects'} data-tab="projects" data-action={home ? 'section:projects' : undefined}>{labels.projects}</a>
  <a href="/world" data-tab="world" aria-current={page === 'world' ? 'true' : 'false'}>{labels.world}</a>
</nav>
