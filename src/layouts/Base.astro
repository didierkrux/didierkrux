---
import { ClientRouter } from 'astro:transitions';
import { getCollection, getEntry } from 'astro:content';
import Stage from '../components/Stage';
import KeyBar from '../components/KeyBar.astro';
import Manual from '../components/Manual.astro';
import Player from '../components/Player.astro';
import { latestSets } from '../lib/content';
import { trackLabel } from '../lib/playlist';
import '../styles/global.css';
import '../styles/layout.css';

interface Props { page: 'home' | 'world' | 'manual' | '404'; title: string; description?: string; noindex?: boolean }
const { page, title, description, noindex = false } = Astro.props;

const profile = (await getEntry('profile', 'profile'))!.data;
const copy = (await getEntry('copy', 'copy'))!.data;
const ambient = (await getCollection('ambient')).sort((a, b) => a.data.order - b.data.order).map((t) => ({ id: t.id, title: t.data.title, artist: t.data.artist, url: t.data.file }));
const sets = latestSets(await getCollection('episodes')).map((e) => ({ title: e.data.title, url: e.data.audio }));
const desc = description ?? copy.site.description;
const ogPage = page === 'world' ? 'world' : 'home';
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = page === 'home'
  ? { '@context': 'https://schema.org', '@type': 'Person', name: profile.name, url: Astro.site?.href, jobTitle: profile.resumeHeadline, nationality: profile.nationality, sameAs: profile.links.map((l) => l.url) }
  : { '@context': 'https://schema.org', '@type': 'WebSite', name: copy.site.name, url: Astro.site?.href, description: copy.site.description };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(`/og/${ogPage}.png`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content={copy.site.name} />
    <meta name="apple-mobile-web-app-title" content={copy.site.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f6fa" media="(prefers-color-scheme: light)" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        try {
          var p = localStorage.getItem('dk:theme');
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var t = p === 'light' || p === 'dark' ? p : dark ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
          document.documentElement.setAttribute('data-dj', 'off');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <ClientRouter />
    <script>
      import { boot } from '../lib/boot';
      boot();
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">{copy.a11y.skip}</a>
    <header class="topbar">
      <a class="site" href="/" data-action="back">{copy.site.name}</a>
      <KeyBar label={copy.a11y.keyBarLabel} />
      <Player labels={copy.music} first={trackLabel(ambient[0])} />
      <button type="button" class="theme-toggle" data-action="cycleTheme" aria-label="Theme">◐</button>
    </header>
    <script type="application/json" id="ambient-playlist" is:inline set:html={JSON.stringify(ambient)} />
    <script type="application/json" id="sets-playlist" is:inline set:html={JSON.stringify(sets)} />
    <div class="frame">
      <Stage client:load transition:persist="stage" page={page} meebits={profile.meebits} still={profile.meebitStill} alt={copy.a11y.stageAlt} labels={copy.meebits} />
      <main id="main" class="content"><slot /></main>
    </div>
    <div class="bottombar"><KeyBar label={copy.a11y.keyBarLabel} /></div>
    <Manual title={copy.manual.title} intro={copy.manual.intro} gestures={copy.manual.gestures} close={copy.manual.close} stageTitle={copy.manual.stageTitle} stage={copy.manual.stage} />
  </body>
</html>
