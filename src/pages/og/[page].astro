---
import { getEntry } from 'astro:content';
import '../../styles/global.css';

export function getStaticPaths() {
  return (['home', 'world'] as const).map((page) => ({ params: { page } }));
}
const page = Astro.params.page as 'home' | 'world';
const copy = (await getEntry('copy', 'copy'))!.data;
const profile = (await getEntry('profile', 'profile'))!.data;
const hero = copy.hero[page];
---
<!doctype html>
<html lang="en" data-theme="dark" data-dj="off">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{copy.site.name} · {page} · preview card</title>
    <style>
      body { margin: 0; width: 1200px; height: 630px; overflow: hidden; position: relative; display: grid; grid-template-columns: 1fr 420px; padding: 0; background: linear-gradient(160deg, var(--bg-2), var(--bg) 60%); color: var(--fg); font-family: var(--font-sans); }
      .txt { padding: 72px 64px; display: flex; flex-direction: column; justify-content: center; gap: 18px; }
      .kicker { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--mark); font-size: 22px; }
      h1 { font-size: 64px; line-height: 1.05; margin: 0; }
      p { font-size: 28px; line-height: 1.3; color: var(--muted); margin: 0; max-width: 22ch; }
      .img { display: flex; align-items: flex-end; justify-content: center; }
      .img img { height: 600px; width: auto; filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.45)); }
      .tag { position: absolute; left: 64px; bottom: 40px; font-family: var(--font-mono); color: var(--muted); font-size: 22px; }
    </style>
  </head>
  <body data-og>
    <div class="txt">
      <span class="kicker">didierkrux.com{page === 'world' ? '/world' : ''}</span>
      <h1>{hero.title}</h1>
      <p>{hero.sub}</p>
    </div>
    <div class="img"><img src={profile.meebitStill} alt="" /></div>
    <span class="tag">{copy.site.tagline}</span>
    <script is:inline>
      document.fonts.ready.then(function () { document.body.setAttribute('data-og-ready', 'true'); });
    </script>
  </body>
</html>
